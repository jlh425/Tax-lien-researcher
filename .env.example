# Database
DATABASE_URL=postgresql+asyncpg://aloha:aloha@localhost:5432/aloha
DATABASE_URL_SYNC=postgresql://aloha:aloha@localhost:5432/aloha

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# LLM Provider — choose one: anthropic, openai, ollama, groq, openai-compatible
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-20250514

# Provider API keys (set the one matching your LLM_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# For ollama (local LLMs)
OLLAMA_BASE_URL=http://localhost:11434

# For any OpenAI-compatible endpoint (vLLM, LM Studio, Together AI, etc.)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# Observability
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email/SMS
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# External APIs
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
PEOPLE_DATA_LABS_API_KEY=
HUNTER_API_KEY=

# Captcha
TWOCAPTCHA_API_KEY=

# Environment
ENVIRONMENT=development
LOG_LEVEL=DEBUG
